# Required for the AI agent
OPENROUTER_API_KEY=your_openrouter_api_key
# Choose a model that supports tool calling on OpenRouter.
OPENROUTER_MODEL=google/gemini-2.5-flash

# Required for web search. Get a key from https://tavily.com/
TAVILY_API_KEY=your_tavily_api_key

# Optional: used for OpenRouter attribution
OPENROUTER_APP_TITLE=Bangladesh Multi-Tool AI Agent
OPENROUTER_APP_URL=http://localhost
